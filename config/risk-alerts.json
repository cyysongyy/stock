{
  "version": 1,
  "_說明": "預警系統參數。修改後下一次排程（約 15 分鐘內）就會生效。points 是觸發時加的分數，總分上限 100；tiers 由寬到嚴，取符合的最高一級。",

  "levels": [
    { "id": "watch",  "label": "注意", "minScore": 25 },
    { "id": "warn",   "label": "警戒", "minScore": 50 },
    { "id": "danger", "label": "危險", "minScore": 75 }
  ],

  "staleAfterMinutes": 120,
  "minCoverage": 0.6,

  "notify": {
    "minLevel": "warn",
    "cooldownHours": 6,
    "sendRecovery": true,
    "dataIssueCooldownHours": 12,
    "quiet": { "start": "00:00", "end": "06:30", "silentBelow": "danger" }
  },

  "usWeights": { "^SOX": 0.4, "^IXIC": 0.25, "^GSPC": 0.2, "^DJI": 0.15 },
  "asiaSymbols": ["^N225", "^KS11", "^HSI"],
  "taiexWeights": { "us": 0.6, "asia": 0.3 },

  "symbols": {
    "^DJI":      { "name": "道瓊",           "group": "us",     "stooq": "^dji",   "cnbc": ".DJI" },
    "^IXIC":     { "name": "那斯達克",       "group": "us",     "stooq": "^ndq",   "cnbc": ".IXIC" },
    "^GSPC":     { "name": "S&P 500",        "group": "us",     "stooq": "^spx",   "cnbc": ".SPX" },
    "^SOX":      { "name": "費城半導體",     "group": "us",     "stooq": "^sox",   "cnbc": ".SOX" },
    "NVDA":      { "name": "輝達",           "group": "us",     "stooq": "nvda.us","cnbc": "NVDA" },
    "TSM":       { "name": "台積電 ADR",     "group": "us",     "stooq": "tsm.us", "cnbc": "TSM" },
    "^VIX":      { "name": "VIX 恐慌指數",   "group": "us",     "stooq": "^vix",   "cnbc": ".VIX" },
    "^TNX":      { "name": "美國 10 年債殖利率", "group": "macro", "stooq": "10usy.b", "cnbc": "US10Y" },
    "DX-Y.NYB":  { "name": "美元指數",       "group": "macro" },
    "TWD=X":     { "name": "美元/台幣",      "group": "macro",  "stooq": "usdtwd" },
    "CL=F":      { "name": "原油期貨",       "group": "macro",  "stooq": "cl.f" },
    "ES=F":      { "name": "S&P 500 期貨",   "group": "macro",  "stooq": "es.f" },
    "NQ=F":      { "name": "那斯達克期貨",   "group": "macro",  "stooq": "nq.f" },
    "^N225":     { "name": "日經 225",       "group": "asia",   "stooq": "^nkx",   "cnbc": ".N225" },
    "^KS11":     { "name": "韓國綜合",       "group": "asia",   "stooq": "^kospi", "cnbc": ".KS11" },
    "^HSI":      { "name": "恆生指數",       "group": "asia",   "stooq": "^hsi",   "cnbc": ".HSI" },
    "^TWII":     { "name": "台灣加權指數",   "group": "tw",     "stooq": "^twse",  "cnbc": ".TWII" }
  },

  "rules": [
    { "id": "sox",      "symbol": "^SOX",     "metric": "chg1d", "op": "<=", "label": "費城半導體重挫",
      "why": "台灣電子權值股（台積電、聯發科等）與費半高度連動",
      "tiers": [ { "value": -2, "points": 25 }, { "value": -4, "points": 45 } ] },
    { "id": "ixic",     "symbol": "^IXIC",    "metric": "chg1d", "op": "<=", "label": "那斯達克重挫",
      "why": "美股科技股走弱，台股電子類股通常隔天跟著承壓",
      "tiers": [ { "value": -1.5, "points": 20 }, { "value": -3, "points": 35 } ] },
    { "id": "gspc",     "symbol": "^GSPC",    "metric": "chg1d", "op": "<=", "label": "S&P 500 下跌",
      "why": "美股大盤走弱，全球風險偏好下降",
      "tiers": [ { "value": -1.5, "points": 15 }, { "value": -3, "points": 30 } ] },
    { "id": "dji",      "symbol": "^DJI",     "metric": "chg1d", "op": "<=", "label": "道瓊下跌",
      "why": "傳產與藍籌股走弱",
      "tiers": [ { "value": -1.5, "points": 10 } ] },
    { "id": "usw",      "symbol": "_usWeighted", "metric": "value", "op": "<=", "label": "美股加權指標轉弱",
      "why": "四大指數加權（費半 40%、那指 25%、S&P 20%、道瓊 15%），與首頁預測卡同一算法",
      "tiers": [ { "value": -1.2, "points": 20 } ] },
    { "id": "nvda",     "symbol": "NVDA",     "metric": "chg1d", "op": "<=", "label": "輝達大跌",
      "why": "AI 伺服器供應鏈領頭股，台灣相關族群連動強",
      "tiers": [ { "value": -4, "points": 15 }, { "value": -7, "points": 25 } ] },
    { "id": "tsm",      "symbol": "TSM",      "metric": "chg1d", "op": "<=", "label": "台積電 ADR 大跌",
      "why": "台積電 ADR 是 2330 隔天開盤最直接的參考",
      "tiers": [ { "value": -3, "points": 20 }, { "value": -5, "points": 30 } ] },
    { "id": "vix_lv",   "symbol": "^VIX",     "metric": "last",  "op": ">=", "label": "VIX 恐慌指數偏高",
      "why": "市場避險情緒升高",
      "tiers": [ { "value": 25, "points": 15 }, { "value": 30, "points": 30 } ] },
    { "id": "vix_jump", "symbol": "^VIX",     "metric": "chg1d", "op": ">=", "label": "VIX 單日急升",
      "why": "恐慌情緒快速升溫",
      "tiers": [ { "value": 15, "points": 15 } ] },
    { "id": "tnx",      "symbol": "^TNX",     "metric": "chg1d", "op": ">=", "label": "美債殖利率急升",
      "why": "殖利率快速上升壓抑成長股與科技股估值（此處為相對變動 %）",
      "tiers": [ { "value": 3, "points": 10 } ] },
    { "id": "dxy",      "symbol": "DX-Y.NYB", "metric": "chg1d", "op": ">=", "label": "美元走強",
      "why": "美元急升常伴隨新興市場資金流出",
      "tiers": [ { "value": 0.8, "points": 5 } ] },
    { "id": "twd",      "symbol": "TWD=X",    "metric": "chg1d", "op": ">=", "label": "台幣急貶",
      "why": "台幣貶值常對應外資匯出壓力",
      "tiers": [ { "value": 0.7, "points": 10 } ] },
    { "id": "oil",      "symbol": "CL=F",     "metric": "chg1d", "op": ">=", "label": "油價急漲",
      "why": "通膨與成本壓力",
      "tiers": [ { "value": 5, "points": 5 } ] },
    { "id": "es_fut",   "symbol": "ES=F",     "metric": "chg1d", "op": "<=", "label": "S&P 500 期貨走低",
      "why": "美股盤前盤後的即時風向",
      "tiers": [ { "value": -1, "points": 15 }, { "value": -2, "points": 25 } ] },
    { "id": "nq_fut",   "symbol": "NQ=F",     "metric": "chg1d", "op": "<=", "label": "那斯達克期貨走低",
      "why": "科技股盤前盤後的即時風向",
      "tiers": [ { "value": -1.5, "points": 15 }, { "value": -3, "points": 25 } ] },
    { "id": "n225",     "symbol": "^N225",    "metric": "chg1d", "op": "<=", "label": "日經大跌",
      "why": "亞洲股市同步走弱",
      "tiers": [ { "value": -2, "points": 10 } ] },
    { "id": "ks11",     "symbol": "^KS11",    "metric": "chg1d", "op": "<=", "label": "韓股大跌",
      "why": "韓國與台灣同為半導體與電子出口導向市場",
      "tiers": [ { "value": -2, "points": 10 } ] },
    { "id": "hsi",      "symbol": "^HSI",     "metric": "chg1d", "op": "<=", "label": "恆生指數大跌",
      "why": "亞洲風險偏好下降",
      "tiers": [ { "value": -2, "points": 5 } ] },
    { "id": "twii",     "symbol": "^TWII",    "metric": "chg1d", "op": "<=", "label": "台股加權指數下跌",
      "why": "台股自身已轉弱",
      "tiers": [ { "value": -1.5, "points": 10 } ] }
  ],

  "exposure": [
    { "id": "semi",   "label": "半導體／電子權值股",
      "codes": ["2330", "2454", "2303", "3711", "3034", "2379", "3443", "3661", "2308", "2382", "3231", "2317"],
      "nameRegex": "台積|聯發科|聯電|日月光|半導體|晶圓|廣達|緯創|鴻海",
      "factors": ["^SOX", "TSM", "NVDA", "^IXIC", "NQ=F", "usw"] },
    { "id": "nasdaq", "label": "追蹤那斯達克／美股科技的 ETF",
      "nameRegex": "那斯達克|納斯達克|NASDAQ|美國科技|科技",
      "factors": ["^IXIC", "NQ=F", "nvda", "usw"] },
    { "id": "sp500",  "label": "追蹤 S&P 500／美股大盤的 ETF",
      "nameRegex": "標普|S&P|美國500|美國大型|美股",
      "factors": ["^GSPC", "ES=F", "usw"] },
    { "id": "soxetf", "label": "費城半導體相關 ETF",
      "nameRegex": "費城半導體|費半",
      "factors": ["^SOX", "TSM", "NVDA"] },
    { "id": "twbroad","label": "台股大盤型 ETF",
      "codes": ["0050", "0056", "006208", "00878", "00919", "00929"],
      "nameRegex": "台灣50|台灣加權|高股息|台灣領袖",
      "factors": ["^TWII", "^SOX", "usw", "twd"] },
    { "id": "default","label": "一般台股", "default": true,
      "factors": ["^TWII", "usw", "twd"] }
  ]
}
